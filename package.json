{
  "name": "quickquill",
  "version": "1.0.0",
  "description": "A clean Markdown editor for macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "build": "electron-builder --mac --dir",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "app.quickquill",
    "productName": "QuickQuill",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "electron": "^29.4.6",
    "electron-builder": "^24.9.1",
    "playwright": "^1.61.0"
  }
}
